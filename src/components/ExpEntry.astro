---
import { chunkId, type Experience } from '../data/site';
interface Props {
  entry: Experience;
  /** Lead with the role, with the org as the subline (jobs where the org is generic). */
  roleFirst?: boolean;
}
const { entry: e, roleFirst = false } = Astro.props;
const title = roleFirst ? e.role : e.org;
const sub = roleFirst ? e.org : e.role;
---

<li class="exp reveal" data-chunk={chunkId('exp', e.slug)}>
  <div class="exp-time">
    <p class="exp-when">{e.when}</p>
    <p class="exp-where">{e.where}</p>
  </div>
  <div class="exp-body">
    <h3 class="exp-title" set:html={title}></h3>
    <p class="exp-sub" set:html={sub}></p>
    <p class="exp-desc" set:html={e.desc}></p>
    <p class="exp-tags">
      {e.tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
    {e.link && (
      <a class="exp-link" href={e.link.href} target="_blank" rel="noopener noreferrer">
        {e.link.label}
      </a>
    )}
  </div>
</li>
