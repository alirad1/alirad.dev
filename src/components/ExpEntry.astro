---
import type { Experience } from '../data/site';
interface Props { entry: Experience }
const { entry: e } = Astro.props;
---

<li class="exp reveal">
  <div class="exp-lead">
    <h4 class="exp-org" set:html={e.org}></h4>
    <p class="exp-role">{e.role}</p>
  </div>
  <div class="exp-detail">
    <p class="exp-meta">
      <span class="exp-when">{e.when}</span>
      <span class="exp-sep" aria-hidden="true">·</span>
      <span>{e.where}</span>
    </p>
    <p class="exp-desc" set:html={e.desc}></p>
    <p class="exp-tags">
      {e.tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
    {e.link && (
      <a class="exp-more" href={e.link.href} target="_blank" rel="noopener noreferrer">
        {e.link.label}
      </a>
    )}
  </div>
</li>
