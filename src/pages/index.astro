---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExpEntry from '../components/ExpEntry.astro';
import Moment from '../components/Moment.astro';
import { projects, research, clubs, moments } from '../data/site';

const filters = [
  { key: 'all', label: 'All' },
  { key: 'live', label: 'Live' },
  { key: 'webdev', label: 'Web' },
  { key: 'aws', label: 'AWS' },
  { key: 'python', label: 'Python' },
  { key: 'java', label: 'Java' },
  { key: 'sql', label: 'SQL' },
  { key: 'award', label: 'Awarded' },
];
---

<Base jsonLd>
  <main class="page" id="top">
    <!-- Hero -->
    <section class="hero" data-chunk="about" aria-labelledby="heroName">
      <p class="hero-eyebrow reveal">
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        Computer Engineering · Texas A&amp;M University
      </p>

      <h1 class="hero-name reveal" id="heroName">Ali Rad</h1>

      <p class="hero-lede reveal">
        I build <strong>desktop and web tools that people actually run</strong> — a time-lapse recorder
        for study sessions, a wallpaper that redraws itself every morning, a habit tracker that argues back.
      </p>

      <dl class="spec reveal">
        <div class="spec-row"><dt class="spec-key">Builds</dt><dd class="spec-val">Desktop apps, web apps, games</dd></div>
        <div class="spec-row"><dt class="spec-key">Stack</dt><dd class="spec-val">Java · C++ · Python · JavaScript · SQL</dd></div>
        <div class="spec-row"><dt class="spec-key">Based</dt><dd class="spec-val">College Station, Texas</dd></div>
        <div class="spec-row"><dt class="spec-key">Status</dt><dd class="spec-val"><span class="spec-chip">Seeking summer internships</span></dd></div>
      </dl>

      <div class="hero-actions reveal">
        <a class="btn btn-primary" href="#work">
          See the work
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn-ghost" href="mailto:alizrad99@gmail.com">Email me</a>
        <div class="hero-socials">
          <a href="https://github.com/alirad1" target="_blank" rel="me noopener noreferrer" class="icon-link" aria-label="GitHub">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/alirad07/" target="_blank" rel="me noopener noreferrer" class="icon-link" aria-label="LinkedIn">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Work -->
    <section class="section" id="work" aria-labelledby="workHeading">
      <div class="section-head reveal">
        <span class="section-index">01</span>
        <h2 class="section-title" id="workHeading">Selected work</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{projects.length} entries</span>
      </div>

      <p class="section-note reveal">
        Everything here is mine end to end. Five are live right now — open them and click around.
      </p>

      <div class="filters reveal" role="group" aria-label="Filter projects by tag">
        <span class="filters-label">Filter</span>
        <div class="filters-pills">
          {filters.map((f) => (
            <button type="button" class:list={['pill', { active: f.key === 'all' }]} data-filter={f.key}>{f.label}</button>
          ))}
        </div>
      </div>

      <div class="work-grid" id="projectsGrid">
        <p id="projectsEmpty" class="work-empty" hidden>No projects match that filter.</p>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <!-- Experience -->
    <section class="section" id="experience" aria-labelledby="expHeading">
      <div class="section-head reveal">
        <span class="section-index">02</span>
        <h2 class="section-title" id="expHeading">Experience</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{research.length + clubs.length} entries</span>
      </div>

      <h3 class="group-label reveal">Research &amp; work</h3>
      <ul class="exp-list">
        {research.map((entry) => <ExpEntry entry={entry} />)}
      </ul>

      <h3 class="group-label reveal">Clubs &amp; organizations</h3>
      <ul class="exp-list">
        {clubs.map((entry) => <ExpEntry entry={entry} />)}
      </ul>
    </section>

    <!-- Moments -->
    <section class="section section-strip" id="moments" aria-labelledby="momentsHeading">
      <div class="section-head reveal">
        <span class="section-index">03</span>
        <h2 class="section-title" id="momentsHeading">Moments</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{moments.length} frames</span>
      </div>

      <div class="strip-top reveal">
        <p class="section-note">
          Pitch wins, podiums, and a lot of music. Scroll the strip sideways — drag it, flick it, or use the arrows.
        </p>
        <div class="strip-controls">
          <span class="strip-counter" id="stripCounter" aria-live="polite">01 / {String(moments.length).padStart(2, '0')}</span>
          <button class="strip-btn" id="stripPrev" type="button" aria-label="Previous frames" aria-controls="strip">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button class="strip-btn" id="stripNext" type="button" aria-label="Next frames" aria-controls="strip">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>

      <div class="strip reveal" id="strip" role="region" aria-label="Photo filmstrip, scrolls horizontally" tabindex="0">
        {moments.map((moment) => <Moment moment={moment} />)}
      </div>
    </section>

    <!-- Contact -->
    <section class="section" id="contact" data-chunk="contact" aria-labelledby="contactHeading">
      <div class="section-head reveal">
        <span class="section-index">04</span>
        <h2 class="section-title" id="contactHeading">Get in touch</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">Open to summer 2026</span>
      </div>

      <div class="contact reveal">
        <p class="contact-lede">
          Thanks for reading this far. I'm looking for a summer internship, and I answer every email —
          about a role, a project on this page, or something you're building.
        </p>
        <a class="contact-email" href="mailto:alizrad99@gmail.com">alizrad99@gmail.com</a>
        <dl class="contact-spec">
          <div class="spec-row">
            <dt class="spec-key">GitHub</dt>
            <dd class="spec-val"><a href="https://github.com/alirad1" target="_blank" rel="me noopener noreferrer">github.com/alirad1</a></dd>
          </div>
          <div class="spec-row">
            <dt class="spec-key">LinkedIn</dt>
            <dd class="spec-val"><a href="https://www.linkedin.com/in/alirad07/" target="_blank" rel="me noopener noreferrer">linkedin.com/in/alirad07</a></dd>
          </div>
          <div class="spec-row">
            <dt class="spec-key">Location</dt>
            <dd class="spec-val">College Station, Texas</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
</Base>
