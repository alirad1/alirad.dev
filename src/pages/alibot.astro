---
/* The AliBot write-up. Prose comes from src/data/alibot.ts, which is also a
   corpus source, so the bot can answer questions about itself from the same
   text a reader sees here. The eval table reads the committed results file. */

import Base from '../layouts/Base.astro';
import { alibotSections } from '../data/alibot';
import results from '../../alibot/evals/results.json';

type EvalResults = {
  ranAt: string;
  model: string;
  n: number;
  metrics: Record<string, number | string>;
  rows?: unknown[];
};

const evals = results as EvalResults;
const hasEvals = Boolean(evals?.ranAt);

const stages = [
  {
    key: 'Ask',
    text: 'The question is capped at 500 characters, checked against a per-address rate limit of ten a minute, and passed to the Worker.',
  },
  {
    key: 'Embed',
    text: 'bge-base-en-v1.5 turns the question into a 768-dimension vector. The same model embedded every chunk at ingest, so the two are comparable.',
  },
  {
    key: 'Search',
    text: 'Cloudflare Vectorize returns the twelve nearest chunks. BM25 over the bundled corpus returns its own twelve, catching the exact words embeddings blur.',
  },
  {
    key: 'Fuse',
    text: 'Reciprocal rank fusion combines the two rankings by position rather than score, so cosine similarity and BM25 never have to share a scale. Top eight advance.',
  },
  {
    key: 'Rerank',
    text: 'bge-reranker-base reads the question and each candidate together and scores them properly. The best four become sources.',
  },
  {
    key: 'Gate',
    text: 'If the best score falls below the threshold, AliBot declines here and the model is never called. An off-topic question costs nothing.',
  },
  {
    key: 'Answer',
    text: 'Llama 3.3 70B receives the four numbered sources with instructions to use only those and mark each sentence. Tokens stream to the browser as they are produced.',
  },
  {
    key: 'Account',
    text: 'Every stage is timed, every token counted, and the cost recorded in neurons and dollars. The Details panel under each answer shows the same numbers.',
  },
];

const models = [
  {
    role: 'Embeddings',
    id: '@cf/baai/bge-base-en-v1.5',
    why: '768 dimensions. The small variant is cheaper but loses the vocabulary matches that make the dense half worth having.',
  },
  {
    role: 'Reranking',
    id: '@cf/baai/bge-reranker-base',
    why: 'A cross-encoder reads the question and the chunk together, which a vector search cannot. It costs 283 neurons per million tokens, so it is effectively free.',
  },
  {
    role: 'Generation',
    id: '@cf/meta/llama-3.3-70b-instruct-fp8-fast',
    why: 'Chosen over the 8B model on eval results: better at sticking to the sources and at declining. It buys roughly 80 answers a day instead of 500.',
  },
];

const guardrails = [
  'A grounding gate: below the reranker threshold AliBot declines instead of guessing, without calling the model.',
  'Visitor text only ever appears in the user turn. It is never spliced into the system instructions.',
  'The sources are Ali’s own site and repositories, not arbitrary web pages.',
  'Model output is rendered as text nodes, never as HTML, so nothing it writes can execute in the page.',
  'Questions are capped at 500 characters and history at six turns.',
  'Ten questions a minute per address, enforced by a Cloudflare rate-limit binding.',
  'Requests are accepted only from alirad.dev.',
];

const metricLabels: Record<string, string> = {
  recallAt4: 'Recall@4',
  citationRate: 'Answers citing a real source',
  declineAccuracy: 'Out-of-scope questions declined',
  injectionResistance: 'Injection attempts refused',
  p50Ms: 'Median response',
  p95Ms: '95th percentile response',
  meanNeurons: 'Mean neurons per answer',
};

function formatMetric(key: string, value: number | string): string {
  if (typeof value === 'string') return value;
  if (key.endsWith('Ms')) return `${Math.round(value)} ms`;
  if (key === 'meanNeurons') return value.toFixed(1);
  return `${Math.round(value * 100)}%`;
}
---

<Base
  chat
  title="How AliBot works — Ali Rad"
  description="AliBot is a retrieval-augmented assistant on alirad.dev: hybrid search over the site's own content, cross-encoder reranking, a grounding gate, streamed answers with citations, and an eval harness. Built on Cloudflare Workers AI and Vectorize."
  canonical="https://alirad.dev/alibot"
>
  <main class="page" id="top">
    <section class="hero" aria-labelledby="botHeading">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        Retrieval-augmented generation · Cloudflare Workers
      </p>

      <h1 class="hero-name" id="botHeading">AliBot</h1>

      <p class="hero-lede">
        The assistant in the corner of this site answers from <strong>the site itself</strong>, not
        from memory. This is how it retrieves, what stops it inventing things, and what it costs.
      </p>

      <dl class="spec">
        <div class="spec-row"><dt class="spec-key">Runtime</dt><dd class="spec-val">Cloudflare Worker · TypeScript</dd></div>
        <div class="spec-row"><dt class="spec-key">Retrieval</dt><dd class="spec-val">Vectorize + BM25 · reciprocal rank fusion · cross-encoder rerank</dd></div>
        <div class="spec-row"><dt class="spec-key">Generation</dt><dd class="spec-val">Llama 3.3 70B on Workers AI, streamed</dd></div>
        <div class="spec-row"><dt class="spec-key">Running cost</dt><dd class="spec-val"><span class="spec-chip">$0 — free tiers, no card on file</span></dd></div>
      </dl>

      <div class="hero-actions">
        <a class="btn btn-primary" href="https://github.com/alirad1/alirad.dev/tree/master/alibot" target="_blank" rel="noopener noreferrer">
          Read the source
        </a>
        <a class="btn btn-ghost" href="/#work">Back to the work</a>
      </div>
    </section>

    <!-- The pipeline -->
    <section class="section" id="pipeline" aria-labelledby="pipelineHeading">
      <div class="section-head">
        <span class="section-index">01</span>
        <h2 class="section-title" id="pipelineHeading">What happens when you ask</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{stages.length} stages</span>
      </div>

      <p class="section-note">
        Each stage hands the next one a smaller, better set of candidates. The numbers are a real
        sequence here, which is the only reason they are numbered.
      </p>

      <ol class="exp-list">
        {stages.map((stage, i) => (
          <li class="exp">
            <div class="exp-lead">
              <h3 class="exp-org">{stage.key}</h3>
              <p class="exp-role">Stage {String(i + 1).padStart(2, '0')}</p>
            </div>
            <div class="exp-detail">
              <p class="exp-desc">{stage.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Written up -->
    <section class="section" id="notes" aria-labelledby="notesHeading">
      <div class="section-head">
        <span class="section-index">02</span>
        <h2 class="section-title" id="notesHeading">In more detail</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{alibotSections.length} notes</span>
      </div>

      <ul class="exp-list">
        {alibotSections.map((note) => (
          <li class="exp" id={note.id}>
            <div class="exp-lead">
              <h3 class="exp-org">{note.title}</h3>
            </div>
            <div class="exp-detail">
              <p class="exp-desc">{note.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Models -->
    <section class="section" id="models" aria-labelledby="modelsHeading">
      <div class="section-head">
        <span class="section-index">03</span>
        <h2 class="section-title" id="modelsHeading">The three models</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">Workers AI</span>
      </div>

      <ul class="exp-list">
        {models.map((model) => (
          <li class="exp">
            <div class="exp-lead">
              <h3 class="exp-org">{model.role}</h3>
              <p class="exp-role">{model.id}</p>
            </div>
            <div class="exp-detail">
              <p class="exp-desc">{model.why}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Guardrails -->
    <section class="section" id="guardrails" aria-labelledby="guardHeading">
      <div class="section-head">
        <span class="section-index">04</span>
        <h2 class="section-title" id="guardHeading">Guardrails</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{guardrails.length} rules</span>
      </div>

      <dl class="spec">
        {guardrails.map((rule, i) => (
          <div class="spec-row">
            <dt class="spec-key">{String(i + 1).padStart(2, '0')}</dt>
            <dd class="spec-val">{rule}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Evals -->
    <section class="section" id="evals" aria-labelledby="evalHeading">
      <div class="section-head">
        <span class="section-index">05</span>
        <h2 class="section-title" id="evalHeading">How well it works</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{hasEvals ? `${evals.n} questions` : 'not yet run'}</span>
      </div>

      <p class="section-note">
        A golden set runs against the deployed Worker: questions the site can answer, questions it
        should refuse, and prompt-injection attempts. Model choice was settled by running the same
        set against both candidates.
      </p>

      {hasEvals ? (
        <dl class="spec">
          {Object.entries(evals.metrics).map(([key, value]) => (
            <div class="spec-row">
              <dt class="spec-key">{metricLabels[key] ?? key}</dt>
              <dd class="spec-val">{formatMetric(key, value)}</dd>
            </div>
          ))}
          <div class="spec-row">
            <dt class="spec-key">Model</dt>
            <dd class="spec-val">{evals.model}</dd>
          </div>
          <div class="spec-row">
            <dt class="spec-key">Last run</dt>
            <dd class="spec-val">{new Date(evals.ranAt).toISOString().slice(0, 10)}</dd>
          </div>
        </dl>
      ) : (
        <p class="section-note">
          No run recorded yet. The harness lives in <code>alibot/evals</code> and writes its results
          here.
        </p>
      )}
    </section>
  </main>
</Base>
